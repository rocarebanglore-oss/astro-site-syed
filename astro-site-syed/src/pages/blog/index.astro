---
import Layout from '@/layouts/Layout.astro';
import { BLOG_POSTS } from '@/data/blogPosts'; // Apna sahi path daalna

// Cloudinary image optimization (chhoti image ke liye)
const optimizeImg = (url: string) => {
  if (!url) return '';
  if (url.includes('/upload/')) {
    return url.replace('/upload/', '/upload/f_auto,q_auto,w_200/');
  }
  return url;
};
---

<Layout title="RO Service Blog & Tips | Roservice Support Bangalore" description="Read expert tips, maintenance guides, and troubleshooting articles for Kent, Aquaguard, Pureit, and all RO water purifiers in Bangalore.">
  
  <section class="py-12 bg-white min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Simple Header -->
      <div class="border-b border-slate-200 pb-6 mb-8">
        <h1 class="text-3xl font-extrabold text-slate-900">RO Service Blog & Guides</h1>
        <p class="text-slate-500 mt-2">Expert advice and troubleshooting tips for your water purifier.</p>
      </div>

      <!-- Simple List Layout -->
      <div class="space-y-8">
        {BLOG_POSTS.map((post) => (
          <article class="flex flex-col sm:flex-row gap-6 group">
            
            <!-- Small Thumbnail -->
            <a href={`/blog/${post.slug}`} class="w-full sm:w-48 h-32 shrink-0 rounded-lg overflow-hidden bg-slate-100 border border-slate-200">
              <img 
                src={optimizeImg(post.image)} 
                alt={post.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </a>

            <!-- Text Content -->
            <div class="flex flex-col justify-center">
              <div class="text-xs font-semibold text-blue-600 mb-2 uppercase tracking-wide">
                {post.category}
              </div>
              <a href={`/blog/${post.slug}`}>
                <h2 class="text-xl font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition-colors">
                  {post.title}
                </h2>
              </a>
              <p class="text-sm text-slate-600 leading-relaxed mb-3 line-clamp-2">
                {post.description}
              </p>
              <div class="text-xs text-slate-400">
                {post.publishedAt} • {post.readingTime}
              </div>
            </div>

          </article>
        ))}
      </div>

    </div>
  </section>

</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;  
    overflow: hidden;
  }
</style>