---
import Layout from '@/layouts/Layout.astro';
import { BLOG_POSTS } from '@/data/blogPosts';

// ⭐ Ye line build warning hatayegi aur page ko static banayegi (Super Fast)
export const prerender = true;

export function getStaticPaths() {
  return BLOG_POSTS.map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = BLOG_POSTS.find((p) => p.slug === slug);

if (!post) {
  return Astro.redirect('/404');
}
---

<Layout title={`${post.title} | Roservice Support`} description={post.description}>
  
  <section class="py-12 bg-white min-h-screen">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Breadcrumb & Back Link -->
      <div class="mb-6">
        <a href="/blog" class="text-sm text-blue-600 font-semibold hover:underline flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
          Back to Blog
        </a>
      </div>

      <!-- Article Header -->
      <header class="mb-8 border-b border-slate-200 pb-8">
        <span class="text-xs font-bold text-blue-600 uppercase tracking-wider mb-2 block">
          {post.category}
        </span>
        <h1 class="text-3xl sm:text-4xl font-extrabold text-slate-900 leading-tight mb-4">
          {post.title}
        </h1>
        
        <div class="flex items-center gap-3 text-sm text-slate-500">
          <span class="font-medium text-slate-800">By {post.author}</span>
          <span>•</span>
          <span>{post.publishedAt}</span>
          <span>•</span>
          <span>{post.readingTime}</span>
        </div>
      </header>

      <!-- Article Content (Text Focused) -->
      <article class="prose prose-slate prose-lg max-w-none text-justify">
        
        <!-- Lead Paragraph -->
        <p class="text-lg font-medium text-slate-800 leading-relaxed mb-8">
          {post.content.lead}
        </p>

        <!-- Dynamic Sections -->
        {post.content.sections.map((section, idx) => (
          <div class="mb-8" key={idx}>
            <h2 class="text-2xl font-bold text-slate-900 mb-4 mt-8">{section.heading}</h2>
            
            {section.paragraphs.map((para, pIdx) => (
              <p class="mb-4 text-slate-600 leading-relaxed" key={pIdx}>{para}</p>
            ))}

            {section.bulletPoints && section.bulletPoints.length > 0 && (
              <ul class="list-disc pl-6 space-y-2 my-4 text-slate-600">
                {section.bulletPoints.map((point, bIdx) => (
                  <li key={bIdx} class="leading-relaxed">{point}</li>
                ))}
              </ul>
            )}
          </div>
        ))}

      </article>

      <!-- Simple CTA -->
      <div class="mt-12 pt-8 border-t border-slate-200 bg-slate-50 p-6 rounded-xl text-center">
        <h3 class="text-lg font-bold text-slate-900 mb-2">Need help with your RO Purifier?</h3>
        <p class="text-slate-600 mb-4 text-sm">Get same-day doorstep service in Bangalore with a 90-day warranty.</p>
        <a href="tel:+919008315606" class="inline-block bg-[#0c2b5e] text-white font-bold px-6 py-3 rounded-lg shadow hover:bg-[#081f45] transition-colors">
          Call Now: 070901 70092
        </a>
      </div>

      <!-- Related Brand Link -->
      {post.relatedBrandSlug && (
        <div class="mt-8 text-center text-sm">
          <span class="text-slate-500">Looking for </span>
          <a href={`/${post.relatedBrandSlug}`} class="text-blue-600 font-bold hover:underline">
            {post.relatedBrandName} Service?
          </a>
        </div>
      )}

    </div>
  </section>

</Layout>