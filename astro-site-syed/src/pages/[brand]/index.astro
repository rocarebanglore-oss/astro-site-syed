---
import Layout from '@/layouts/Layout.astro';
import { BrandPageLayout } from '@/components/BrandPageLayout';
import { BRAND_PAGES_DATA } from '@/data/content';

// ✅ 1. BUILD ERROR FIX: Astro ko bataya ki data file mein jo brands hain unke pages banao
export function getStaticPaths() {
  const brandKeys = Object.keys(BRAND_PAGES_DATA);
  return brandKeys.map((brand) => ({
    params: { brand: brand },
  }));
}

const { brand: brandSlug } = Astro.params;

// ✅ 2. ASLI DATA: Data file se brand ka data nikal rahe hain
const brandData = BRAND_PAGES_DATA[brandSlug?.toLowerCase() || ''];

if (!brandData) {
  return Astro.redirect('/404');
}

const title = brandData.metaTitle || `${brandData.name} RO Service Bangalore`;
const description = brandData.metaDescription || 'Doorstep RO service in Bangalore.';
const canonical = `https://Roservicecare24x7.co.in/${brandSlug}`;

// Preload image for speed
const heroImagePreload = brandData.heroBgImage;
---

<Layout
  title={title}
  description={description}
  canonical={canonical}
  preloadImage={heroImagePreload}
>
  {/* ✅ FIX: Yahan 'client:idle' laga diya hai. Isse page 100/100 speed par rahega aur form bhi kaam karega */}
  <BrandPageLayout brand={brandData} client:idle />
</Layout>
