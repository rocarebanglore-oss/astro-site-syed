---
import Layout from '@/layouts/Layout.astro';

// Astro URL se ID nikalne ki koshish karega
const initialBookingId = Astro.url.searchParams.get('bookingId') || 'RO-XXXXXX';
const returnUrlParam = Astro.url.searchParams.get('returnUrl');

let returnUrl = '/';
let buttonText = 'Back to Home';

if (returnUrlParam) {
  returnUrl = returnUrlParam;
  if (returnUrl.includes('kent')) buttonText = 'Back to Kent Page';
  else if (returnUrl.includes('aquaguard')) buttonText = 'Back to Aquaguard Page';
  else if (returnUrl.includes('pureit')) buttonText = 'Back to Pureit Page';
  else if (returnUrl.includes('aosmith')) buttonText = 'Back to AO Smith Page';
  else if (returnUrl.includes('livpure')) buttonText = 'Back to Livpure Page';
  else buttonText = 'Back to Previous Page';
}
---

<Layout title="Booking Confirmed | Roservice Support" description="Your RO service request has been received.">
  
  <!-- ⭐ FORM CONVERSION TRACKING -->
  <script is:inline>
    if (typeof gtag === 'function') {
      gtag('event', 'conversion', {
        'send_to': 'AW-10934329019/kUwqCOf33KAdELu98t0o' // Form Label
      });
    }

    // ✅ NAYA FIX: Browser URL se asli ID nikal kar screen par update karega
    document.addEventListener('DOMContentLoaded', () => {
      const urlParams = new URLSearchParams(window.location.search);
      const realId = urlParams.get('bookingId');
      
      if (realId) {
        const idElement = document.getElementById('real-booking-id');
        if (idElement) {
          idElement.innerText = realId;
        }
      }
    });
  </script>

  <section class="py-20 bg-slate-50 min-h-[70vh] flex items-center justify-center px-4">
    <div class="max-w-md w-full bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-200 text-center">
      
      <div class="bg-emerald-500 pt-10 pb-8 px-6">
        <div class="w-20 h-20 bg-white rounded-full flex items-center justify-center mx-auto mb-4 shadow-md">
          <svg class="w-10 h-10 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path>
          </svg>
        </div>
        <h1 class="text-2xl font-bold text-white mb-2">Booking Confirmed!</h1>
        <p class="text-emerald-50">Thank you for choosing us.</p>
      </div>

      <div class="p-8">
        <p class="text-slate-600 mb-6 leading-relaxed">
          We have received your service request. Our team will call you within <strong class="text-slate-900">10-15 minutes</strong> to confirm your technician visit.
        </p>

        <div class="bg-blue-50 border border-blue-100 rounded-xl p-4 mb-8">
          <p class="text-xs text-blue-600 font-bold uppercase tracking-wider mb-1">Your Booking ID</p>
          <!-- ✅ FIX: Yahan id="real-booking-id" add kiya hai taaki script isko pakad sake -->
          <h2 id="real-booking-id" class="text-3xl font-extrabold text-[#0c2b5e] tracking-widest">{initialBookingId}</h2>
          <p class="text-[11px] text-slate-500 mt-2">Please save this ID for future reference.</p>
        </div>

        <div class="space-y-3">
          <!-- ⭐ CALL CONVERSION TRACKING (New Number) -->
          <a href="tel:+917090170092" onclick="if(typeof gtag === 'function'){ gtag('event', 'conversion', {'send_to': 'AW-10934329019/darZCOiX3qAdELu98t0o', 'value': 1.0, 'currency': 'INR'}); }" class="w-full flex items-center justify-center gap-2 bg-[#0070e0] hover:bg-[#0060c5] text-white font-bold py-3 px-4 rounded-xl transition-colors">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
            Call Support Now
          </a>
          
          <a href={returnUrl} class="w-full flex items-center justify-center bg-white hover:bg-slate-50 text-slate-700 font-bold py-3 px-4 rounded-xl border border-slate-300 transition-colors">
            {buttonText}
          </a>
        </div>
      </div>

    </div>
  </section>

</Layout>
